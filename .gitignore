coverage
dist
node_modules
*.code-workspace
.env

# The core's skills, copied from node_modules/skyrim-modding-tools-core by npm run build: the core owns them.
skills/

# The mod projects, where projectsDir puts them unless it says otherwise: the user's own work.
projects/

# Credentials and key material — never commit them.
*.p12
*.pfx
*.pem
*.key

# graphify: only the graph, which `graphify query` reads, and its community names, which took an LLM
# to write. The page, the report, the cache, backups and this machine's state `graphify update .` rebuilds.
graphify-out/*
!graphify-out/graph.json
!graphify-out/.graphify_labels.json
